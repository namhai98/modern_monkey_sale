PORT=5001
NODE_ENV=test

# A dedicated test database, separate from dev/prod — src/test/setup.js
# refuses to run unless PGDATABASE contains "test", and freely creates and
# truncates tables in it.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=modern_monkey_sale_test

JWT_SECRET=test_only_secret_do_not_use_in_prod
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=30

APP_URL=http://localhost:5173
CLIENT_ORIGIN=

# Left blank on purpose — sendMail() logs instead of sending when unset,
# which is what the integration tests rely on.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Modern Monkey Sale <no-reply@example.com>
