PORT=5000

# PostgreSQL connection — local dev uses the discrete PG* vars below.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=modern_monkey_sale
# PGSSL=true   # set when your local/remote Postgres requires TLS

# Hosted Postgres (Neon / Render / Supabase): set this instead of the PG* vars.
# When present it takes precedence and TLS is enabled automatically.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

NODE_ENV=development

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MIN=30

# Frontend origin (for CORS + password-reset links). Leave CLIENT_ORIGIN blank
# in dev; the Vite proxy makes requests same-origin.
# APP_URL also derives the OAuth redirect URI (see below), so it must match the
# origin the shopper's browser actually uses.
APP_URL=http://localhost:5173
CLIENT_ORIGIN=

# ── Social sign-in (optional) ────────────────────────────────────────────────
# Each provider's buttons appear on the sign-in screen only once BOTH of its
# variables are set; leave them blank to keep that provider switched off.
#
# The redirect URI to register with both providers is APP_URL plus
#   /api/auth/oauth/google/callback
#   /api/auth/oauth/facebook/callback
# e.g. in dev: http://localhost:5173/api/auth/oauth/google/callback
#
# Google — console.cloud.google.com → APIs & Services → Credentials →
#   Create credentials → OAuth client ID → Web application.
#   Add the redirect URI above under "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com → My Apps → Create App → add the
#   "Facebook Login" product → Settings → Valid OAuth Redirect URIs.
#   Facebook requires HTTPS for live apps; use a dev app for localhost.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMTP — required for password-reset emails. If unset, reset links are logged
# to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Modern Monkey Sale <no-reply@example.com>

# ── Object storage for product images ────────────────────────────────────────
# STORAGE_PROVIDER: local (default; writes to STORAGE_LOCAL_DIR, dev only)
#                 | s3 (any S3-compatible: AWS S3, Cloudflare R2, MinIO, …)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=var/media
# STORAGE_PUBLIC_URL — CDN / public base for image URLs.
#   local: defaults to /media   |   s3: e.g. https://cdn.example.com
STORAGE_PUBLIC_URL=

# Required when STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=            # e.g. https://<accountid>.r2.cloudflarestorage.com (blank for AWS)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
